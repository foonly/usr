{{!-- Sheet Header --}}
<header class="sheet-header actor-header">
	<img
		class="profile-img"
		src="{{actor.img}}"
		data-action="editImage"
		data-edit="img"
		title="{{actor.name}}"
		alt="{{actor.name}}"
		height="100"
		width="100"
	/>
	<div class="header-fields">
		<div class="header-top npc-header-top">
			<h1 class="charname">
				<input
					name="name"
					type="text"
					value="{{actor.name}}"
					placeholder="Name"
				/>
			</h1>
			<div class="header-meta npc-meta">
				<div class="meta-card readonly">
					<span class="meta-label">Modifier</span>
					<span class="meta-value">{{system.damage.modifierText}}</span>
				</div>
			</div>
		</div>
	</div>
</header>

{{!-- Sheet Tab Navigation --}}
<nav class="sheet-tabs tabs">
	<a
		class="item {{tabs.bio.cssClass}}"
		data-action="tab"
		data-group="primary"
		data-tab="bio"
		>Biography</a
	>
	<a
		class="item {{tabs.traits.cssClass}}"
		data-action="tab"
		data-group="primary"
		data-tab="traits"
		>Traits</a
	>
	<a
		class="item {{tabs.combat.cssClass}}"
		data-action="tab"
		data-group="primary"
		data-tab="combat"
		>Combat</a
	>
	<a
		class="item {{tabs.items.cssClass}}"
		data-action="tab"
		data-group="primary"
		data-tab="items"
		>Items</a
	>
</nav>

{{!-- Sheet Body --}}
<section class="sheet-body">
	{{!-- Biography Tab --}}
	<div
		class="tab biography {{tabs.bio.cssClass}}"
		data-group="primary"
		data-tab="bio"
	>
		{{> "systems/usr/templates/actor/parts/actor-biography.hbs"}}
	</div>

	{{!-- Traits Tab --}}
	<div
		class="tab traits {{tabs.traits.cssClass}}"
		data-group="primary"
		data-tab="traits"
	>
		{{> "systems/usr/templates/actor/parts/actor-traits.hbs"}}
	</div>

	{{!-- Combat Tab --}}
	<div
		class="tab combat {{tabs.combat.cssClass}}"
		data-group="primary"
		data-tab="combat"
	>
		{{> "systems/usr/templates/actor/parts/actor-combat.hbs"}}
	</div>

	{{!-- Owned Items Tab --}}
	<div
		class="tab items {{tabs.items.cssClass}}"
		data-group="primary"
		data-tab="items"
	>
		{{> "systems/usr/templates/actor/parts/actor-items.hbs"}}
	</div>
</section>
