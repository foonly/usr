{{!-- Sheet Header --}}
<header class="sheet-header actor-header">
	<img
		class="profile-img"
		src="{{actor.img}}"
		data-action="editImage"
		data-edit="img"
		title="{{actor.name}}"
		alt="{{actor.name}}"
	/>
	<div class="header-fields">
		<h1 class="charname">
			<input
				name="name"
				type="text"
				value="{{actor.name}}"
				placeholder="Name"
			/>
		</h1>
		<div class="meta-card modifiers">
			<span class="meta-label">Modifier</span>
			<span class="meta-value">{{system.damage.modifierText}}</span>
			<span class="meta-label">Mobility</span>
			<span class="meta-value">
				{{#if system.encumbrance.mobility}} {{system.encumbrance.mobility}}
				{{else}} None {{/if}}
			</span>
			<span class="meta-label">Carry</span>
			<span class="meta-value">
				{{system.equipped.weight}} {{system.equipped.unit}}
			</span>
			<hr class="card-divider" />
			<span class="meta-label">Custom Mod</span>
			<div class="custom-mod-controls">
				<select
					name="flags.usr.customModifier"
					class="custom-mod-select"
					data-dtype="Number"
				>
					{{selectOptions customModOptions selected=customModifier}}
				</select>
				<label
					class="custom-mod-checkbox-label"
					title="Keep modifier continuous across rolls"
				>
					<input
						type="checkbox"
						name="flags.usr.customModifierContinuous"
						{{checked
						customModifierContinuous}}
					/>
					<span>Continuous</span>
				</label>
			</div>
		</div>
		<div class="chips">
			{{#each chipsList as |type index|}}
			<div class="chip clickable-chip" data-chip="{{type}}"></div>
			{{/each}}
		</div>
		<div class="meta-card form-group">
			<div class="xp">
				<label for="bonus-xp">XP</label>
				<input
					id="bonus-xp"
					name="system.xp"
					min="0"
					type="number"
					value="{{system.xp}}"
					data-dtype="Number"
				/>
			</div>
			<div class="dice">
				<button class="rollable roll-chip die d6" data-roll-chip="1">1</button>
				<button class="rollable roll-chip die d6" data-roll-chip="2">2</button>
			</div>
		</div>
	</div>
</header>

{{!-- Sheet Tab Navigation --}}
<nav class="sheet-tabs tabs">
	<a
		class="item {{tabs.bio.cssClass}}"
		data-action="tab"
		data-group="primary"
		data-tab="bio"
		>Biography</a
	>
	<a
		class="item {{tabs.traits.cssClass}}"
		data-action="tab"
		data-group="primary"
		data-tab="traits"
		>Traits</a
	>
	<a
		class="item {{tabs.combat.cssClass}}"
		data-action="tab"
		data-group="primary"
		data-tab="combat"
		>Combat</a
	>
	<a
		class="item {{tabs.knowledge.cssClass}}"
		data-action="tab"
		data-group="primary"
		data-tab="knowledge"
		>Knowledge</a
	>
	<a
		class="item {{tabs.items.cssClass}}"
		data-action="tab"
		data-group="primary"
		data-tab="items"
		>Items</a
	>
</nav>

{{!-- Sheet Body --}}
<section class="sheet-body">
	{{!-- Biography Tab --}}
	<div
		class="tab biography {{tabs.bio.cssClass}}"
		data-group="primary"
		data-tab="bio"
	>
		{{> "systems/usr/templates/actor/parts/actor-biography.hbs"}}
	</div>

	{{!-- Traits Tab --}}
	<div
		class="tab traits {{tabs.traits.cssClass}}"
		data-group="primary"
		data-tab="traits"
	>
		{{> "systems/usr/templates/actor/parts/actor-traits.hbs"}}
	</div>

	{{!-- Combat Tab --}}
	<div
		class="tab combat {{tabs.combat.cssClass}}"
		data-group="primary"
		data-tab="combat"
	>
		{{> "systems/usr/templates/actor/parts/actor-combat.hbs"}}
	</div>

	{{!-- Knowledge Tab --}}
	<div
		class="tab features {{tabs.knowledge.cssClass}}"
		data-group="primary"
		data-tab="knowledge"
	>
		{{> "systems/usr/templates/actor/parts/actor-knowledge.hbs"}}
	</div>

	{{!-- Owned Items Tab --}}
	<div
		class="tab items {{tabs.items.cssClass}}"
		data-group="primary"
		data-tab="items"
	>
		{{> "systems/usr/templates/actor/parts/actor-items.hbs"}}
	</div>
</section>
