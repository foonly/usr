<main class="sheet-body">
	<div class="trait-header grid grid-4col">
		<label>{{localize trait.label}}</label>
		<div class="form-group">
			<label>{{localize 'USR.Level'}}</label>
			<input
				type="number"
				min="0"
				max="7"
				name="value"
				value="{{trait.value}}"
				data-dtype="Number"
			/>
		</div>
		<div class="form-group">
			<label>{{localize 'USR.Quickness'}}</label>
			<input
				type="number"
				min="0"
				max="2"
				name="roll"
				value="{{trait.roll}}"
				data-dtype="Number"
			/>
		</div>
		<div class="form-group">
			<label>XP</label>
			<input
				type="number"
				min="0"
				max="5"
				name="xp"
				value="{{trait.xp}}"
				data-dtype="Number"
			/>
		</div>
	</div>

	{{#if trait.hasSpec}}
	<hr />
	<div class="specializations-list">
		<header class="grid grid-4col">
			<span>{{localize 'USR.Specialization'}}</span>
			<span>{{localize 'USR.Level'}}</span>
			<span>{{localize 'USR.Quickness'}}</span>
			<span>XP</span>
		</header>
		{{#each allSpecs as |spec|}}
		<div class="spec-row grid grid-4col {{#if spec.isLegacy}}legacy{{/if}}">
			<span
				class="spec-title"
				title="{{#if spec.isLegacy}}{{localize 'USR.Legacy'}}{{/if}}"
			>
				{{spec.localizedTitle}} {{#if spec.isLegacy}}<i
					class="fas fa-history"
				></i
				>{{/if}}
			</span>
			<input
				type="number"
				min="0"
				max="3"
				name="spec-{{spec.slug}}-value"
				value="{{spec.value}}"
				data-dtype="Number"
			/>
			<input
				type="number"
				min="0"
				max="2"
				name="spec-{{spec.slug}}-roll"
				value="{{spec.roll}}"
				data-dtype="Number"
			/>
			<input
				type="number"
				min="0"
				max="3"
				name="spec-{{spec.slug}}-xp"
				value="{{spec.xp}}"
				data-dtype="Number"
			/>
		</div>
		{{/each}}
	</div>
	{{/if}}
</main>
<footer class="sheet-footer flexrow">
	<button type="button" data-action="saveAndClose">
		<i class="fa fa-check"></i> OK
	</button>
</footer>
