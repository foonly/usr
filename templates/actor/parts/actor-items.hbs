<table class="assets-table">
	<thead>
		<tr>
			<th>{{localize "USR.Asset"}}</th>
			<th>{{localize "USR.AssetAmount"}}</th>
			<th>{{localize "USR.AssetChange"}}</th>
		</tr>
	</thead>
	<tbody>
		{{#each system.assets as |row index|}}
		<tr>
			<td>
				<a
					class="edit-asset action-icon"
					data-index="{{index}}"
					title="{{localize 'USR.EditAsset'}}"
				>
					<i class="fas fa-edit"></i>
				</a>
				{{row.name}}
			</td>
			<td>{{row.amount}}</td>
			<td></td>
		</tr>
		{{/each}}
	</tbody>
</table>
<a class="edit-asset action-icon" title="{{localize 'USR.AddAsset'}}">
	<i class="fas fa-plus"></i>
	{{localize "USR.AddAsset"}}
</a>

<h3 class="section-header">Melee Weapons</h3>
<table class="items-table">
	<thead>
		<tr>
			<th>{{localize "USR.Item"}}</th>
			<th>{{localize "USR.Damage"}}</th>
			<th>{{localize "USR.Specialization"}}</th>
			<th>{{localize "USR.Lethality"}}</th>
			<th>{{localize "USR.Quickness"}}</th>
			<th>{{localize "USR.Impact"}}</th>
			<th>{{localize "USR.DefenseBonus"}}</th>
			<th>{{localize "USR.Reach"}}</th>
			<th>{{localize "USR.Actions"}}</th>
		</tr>
	</thead>
	<tbody>
		{{#each melee as |item id|}}
		<tr class="item draggable" data-item-id="{{item._id}}">
			<td>
				<img src="{{item.img}}" title="{{item.name}}" width="24" height="24" />
				{{item.name}}
			</td>
			<td>{{item.system.damage}}</td>
			<td>{{item.system.specialization}}</td>
			<td>{{item.system.lethality}}</td>
			<td>{{item.system.quickness}}</td>
			<td>{{item.system.impact}}</td>
			<td>{{item.system.defenseBonus}}</td>
			<td>{{item.system.reach}}</td>
			<td>
				<a
					class="item-control item-edit"
					title="Edit Item"
					data-item-id="{{item._id}}"
					><i class="fas fa-edit"></i
				></a>
				<a
					class="item-control item-delete"
					title="Delete Item"
					data-item-id="{{item._id}}"
					><i class="fas fa-trash"></i
				></a>
			</td>
		</tr>
		{{/each}}
	</tbody>
</table>
<a
	class="item-control item-create"
	data-type="melee"
	title="{{localize 'USR.AddMelee'}}"
>
	<i class="fas fa-plus"></i>
	{{localize "USR.AddMelee"}}
</a>

