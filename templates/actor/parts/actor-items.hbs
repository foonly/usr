<table class="assets-table">
	<thead>
		<tr>
			<th>{{localize "USR.Asset"}}</th>
			<th>{{localize "USR.AssetAmount"}}</th>
			<th>{{localize "USR.AssetChange"}}</th>
		</tr>
	</thead>
	<tbody>
		{{#each system.assets as |row index|}}
		<tr>
			<td>
				<a
					class="edit-asset action-icon"
					data-index="{{index}}"
					title="{{localize 'USR.EditAsset'}}"
				>
					<i class="fas fa-edit"></i>
				</a>
				{{row.name}}
			</td>
			<td>{{row.amount}}</td>
			<td></td>
		</tr>
		{{/each}}
	</tbody>
</table>
<a class="edit-asset action-icon" title="{{localize 'USR.AddAsset'}}">
	<i class="fas fa-plus"></i>
	{{localize "USR.AddAsset"}}
</a>

<h3 class="section-header">Melee Weapons</h3>
<table class="items-table">
	<thead>
		<tr>
			<th class="col-eq">Eq</th>
			<th class="col-name">{{localize "USR.Item"}}</th>
			<th class="col-type">{{localize "USR.Type"}}</th>
			<th class="col-actions text-right">{{localize "USR.Actions"}}</th>
		</tr>
	</thead>
	<tbody>
		{{#each melee as |item id|}}
		<tr
			class="item draggable {{#if item.system.equipped}}equipped{{/if}}"
			data-item-id="{{item._id}}"
		>
			<td class="equipped-toggle text-center">
				<a
					class="item-control item-toggle-equipped"
					title="{{#if item.system.equipped}}Unequip{{else}}Equip{{/if}}"
					data-item-id="{{item._id}}"
				>
					<i
						class="fas {{#if item.system.equipped}}fa-check-square{{else}}fa-square{{/if}}"
					></i>
				</a>
			</td>
			<td class="item-name">
				<div class="item-image">
					<img
						src="{{item.img}}"
						title="{{item.name}}"
						width="24"
						height="24"
					/>
				</div>
				<span class="name">{{item.name}}</span>
			</td>
			<td class="item-type text-center">{{item.system.specialization}}</td>
			<td class="item-controls text-right">
				<a
					class="item-control item-edit"
					title="Edit Item"
					data-item-id="{{item._id}}"
					><i class="fas fa-edit"></i
				></a>
				<a
					class="item-control item-delete"
					title="Delete Item"
					data-item-id="{{item._id}}"
					><i class="fas fa-trash"></i
				></a>
			</td>
		</tr>
		{{/each}}
	</tbody>
</table>
<a
	class="item-control item-create full-width"
	data-type="melee"
	title="{{localize 'USR.AddMelee'}}"
>
	<i class="fas fa-plus"></i>
	{{localize "USR.AddMelee"}}
</a>

