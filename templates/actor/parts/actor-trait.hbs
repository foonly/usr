<tr>
	<td class="trait-label">
		<a
			class="trait-edit"
			data-trait="{{key}}"
			title="{{localize 'USR.EditTrait'}}"
		>
			<i class="fas fa-edit"></i>
		</a>
		{{ trait.localizedLabel }}
	</td>
	<td class="trait-value">
		{{trait.value}}{{#if trait.modifier}}
		<span class="modifier"
			>({{numberFormat trait.modifier decimals=0 sign=true}})</span
		>{{/if}}
	</td>

	<td class="trait-xp stars-{{trait.starLevel}}">
		<a class="roll-xp" data-trait="{{key}}">{{trait.xp}}/5</a>
	</td>
	<td class="trait-roll">
		<div class="roll-buttons">
			<button
				class="rollable roll die d10"
				data-roll-usr="4"
				data-trait="{{key}}"
				data-label="{{trait.localizedLabel}}"
			>
				4
			</button>
			<button
				class="rollable roll die d10"
				data-roll-usr="3"
				data-trait="{{key}}"
				data-label="{{trait.localizedLabel}}"
			>
				3
			</button>
			<button
				class="rollable roll die d10"
				data-roll-usr="2"
				data-trait="{{key}}"
				data-label="{{trait.localizedLabel}}"
			>
				2
			</button>
			<button
				class="roll-dialog roll die d10"
				data-trait="{{key}}"
				data-label="{{trait.localizedLabel}}"
			>
				?
			</button>
		</div>
	</td>
</tr>
{{#each trait.spec }}
<tr class="trait-specialization {{#if isLegacy}}legacy{{/if}}">
	<td class="trait-label specialization">
		- {{ localizedTitle }} {{#if isLegacy}}<i
			class="fas fa-history"
			title="{{localize 'USR.Legacy'}}"
		></i
		>{{/if}}
	</td>
	<td class="trait-value">
		{{ value }}{{#if modifier}}
		<span class="modifier"
			>({{numberFormat modifier decimals=0 sign=true}})</span
		>{{/if}}
	</td>
	<td class="trait-xp stars-{{ starLevel }}">
		<a class="roll-xp" data-trait="{{../key}}" data-spec="{{title}}"
			>{{ xp }}/3</a
		>
	</td>
	<td class="trait-roll">
		<div class="roll-buttons">
			<button
				class="rollable roll die d10"
				data-roll-usr="4"
				data-trait="{{ ../key }}"
				data-spec="{{title}}"
				data-label="{{ localizedTitle }}"
			>
				4
			</button>
			<button
				class="rollable roll die d10"
				data-roll-usr="3"
				data-trait="{{ ../key }}"
				data-spec="{{title}}"
				data-label="{{ localizedTitle }}"
			>
				3
			</button>
			<button
				class="rollable roll die d10"
				data-roll-usr="2"
				data-trait="{{ ../key }}"
				data-spec="{{title}}"
				data-label="{{ localizedTitle }}"
			>
				2
			</button>
			<button
				class="roll-dialog roll die d10"
				data-trait="{{ ../key }}"
				data-spec="{{title}}"
				data-label="{{ localizedTitle }}"
			>
				?
			</button>
		</div>
	</td>
</tr>
{{/each}}
