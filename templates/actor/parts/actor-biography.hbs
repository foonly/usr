<div class="form-group">
	<label for="full-name">Full Name</label>
	<div class="form-fields">
		<input
			id="full-name"
			name="system.info.fullName"
			type="text"
			value="{{system.info.fullName}}"
			placeholder="Full Name"
		/>
	</div>
</div>

<div class="grid grid-3col">
	<div class="form-group">
		<label for="age">Age</label>
		<div class="form-fields">
			<input
				id="age"
				name="system.info.age"
				type="text"
				value="{{system.info.age}}"
			/>
		</div>
	</div>
	<div class="form-group">
		<label for="height">Height</label>
		<div class="form-fields">
			<input
				id="height"
				name="system.info.height"
				type="text"
				value="{{system.info.height}}"
			/>
		</div>
	</div>
	<div class="form-group">
		<label for="weight">Weight</label>
		<div class="form-fields">
			<input
				id="weight"
				name="system.info.weight"
				type="text"
				value="{{system.info.weight}}"
			/>
		</div>
	</div>
</div>

<hr />

<div class="contacts-section">
	<div class="section-header flexrow">
		<h3>{{localize "USR.Contacts"}}</h3>
		<a class="edit-contact" title="{{localize 'USR.AddContact'}}">
			<i class="fas fa-plus"></i> {{localize "USR.Add"}}
		</a>
	</div>
	<ul class="contacts-list plain-list">
		{{#each contactList as |contact index|}}
		<li class="contact-item flexrow" data-index="{{index}}">
			<div class="contact-info">
				<span class="contact-name"><strong>{{contact.name}}</strong></span>
				<span class="contact-meta">({{contact.typeLabel}}, {{contact.levelLabel}})</span>
				<div class="contact-short">{{contact.shortDescription}}</div>
			</div>
			<div class="contact-controls flexrow">
				<a class="edit-contact" data-index="{{index}}" title="{{localize 'USR.EditContact'}}">
					<i class="fas fa-edit"></i>
				</a>
			</div>
		</li>
		{{/each}}
	</ul>
</div>

<hr />

<div class="form-group stacked">
	<label>Biography</label>
	<div class="form-fields">
		<prose-mirror
			name="system.biography"
			value="{{system.biography}}"
			data-document-uuid="{{documentUUID}}"
			toggled
			relative
			{{#unless editable}}disabled{{/unless}}
		>{{{enrichedBiography}}}</prose-mirror>
	</div>
</div>
