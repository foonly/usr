<div class="form-group">
	<label for="full-name">Full Name</label>
	<div class="form-fields">
		<input
			id="full-name"
			name="system.info.fullName"
			type="text"
			value="{{system.info.fullName}}"
			placeholder="Full Name"
		/>
	</div>
</div>

<div class="grid grid-3col">
	<div class="form-group">
		<label for="age">Age</label>
		<div class="form-fields">
			<input
				id="age"
				name="system.info.age"
				type="text"
				value="{{system.info.age}}"
			/>
		</div>
	</div>
	<div class="form-group">
		<label for="height">Height</label>
		<div class="form-fields">
			<input
				id="height"
				name="system.info.height"
				type="text"
				value="{{system.info.height}}"
			/>
		</div>
	</div>
	<div class="form-group">
		<label for="weight">Weight</label>
		<div class="form-fields">
			<input
				id="weight"
				name="system.info.weight"
				type="text"
				value="{{system.info.weight}}"
			/>
		</div>
	</div>
</div>

<div class="form-group stacked">
	<label>Biography</label>
	<div class="form-fields">
		<prose-mirror
			name="system.biography"
			value="{{system.biography}}"
			data-document-uuid="{{documentUUID}}"
			toggled
			relative
			{{#unless editable}}disabled{{/unless}}
		>{{{enrichedBiography}}}</prose-mirror>
	</div>
</div>
