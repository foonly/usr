<section class="combat-overview">
	<section class="combat-weapons">
		<h3 class="section-header">Weapons</h3>
		<div class="weapon-cards">
			{{!-- Unarmed Attack --}}
			<div
				class="weapon-card melee-card item unarmed-card"
				data-item-id="unarmed"
			>
				<div class="card-header">
					<img
						src="{{unarmed.img}}"
						title="{{unarmed.name}}"
						width="32"
						height="32"
					/>
					<h4 class="weapon-name">{{unarmed.name}}</h4>
					<div class="weapon-controls"></div>
				</div>
				<div class="card-stats">
					<div class="stat">
						<span class="label">{{localize "USR.Damage"}}:</span>
						<span class="value"
							>{{unarmed.system.damage}} ({{localize
							"USR.LethalityStun"}})</span
						>
					</div>
					<div class="stat">
						<span class="label">{{localize "USR.DefenseBonus"}}:</span>
						<span class="value">{{unarmed.system.defenseBonus}}</span>
					</div>
					<div class="stat">
						<span class="label">{{localize "USR.Reach"}}:</span>
						<span class="value">{{unarmed.system.reach}}</span>
					</div>
				</div>
				<div class="card-buttons">
					<button class="rollable weapon-roll" data-roll-type="attack">
						<i class="fa-solid fa-swords"></i> {{localize "USR.Attack"}}
					</button>
					<button class="rollable weapon-roll" data-roll-type="defend">
						<i class="fa-solid fa-shield-halved"></i> {{localize "USR.Defend"}}
					</button>
				</div>
			</div>

			{{#each equippedMelee as |item id|}}
			<div class="weapon-card melee-card item" data-item-id="{{_id}}">
				<div class="card-header">
					<img
						src="{{item.img}}"
						title="{{item.name}}"
						width="32"
						height="32"
					/>
					<h4 class="weapon-name">{{item.name}}</h4>
					<div class="weapon-controls">
						<a
							class="item-control item-toggle-equipped"
							title="Unequip"
							data-item-id="{{_id}}"
							><i class="fas fa-shield-slash"></i
						></a>
						<a
							class="item-control item-edit"
							title="Edit Item"
							data-item-id="{{_id}}"
							><i class="fas fa-edit"></i
						></a>
					</div>
				</div>
				<div class="card-stats">
					<div class="stat">
						<span class="label">{{localize "USR.Damage"}}:</span>
						<span class="value"
							>{{item.system.damage}} ({{localize (concat "USR.Lethality"
							(capitalize item.system.lethality))}})</span
						>
					</div>
					<div class="stat">
						<span class="label">{{localize "USR.DefenseBonus"}}:</span>
						<span class="value">{{item.system.defenseBonus}}</span>
					</div>
					<div class="stat">
						<span class="label">{{localize "USR.Reach"}}:</span>
						<span class="value">{{item.system.reach}}</span>
					</div>
				</div>
				<div class="card-buttons">
					<button class="rollable weapon-roll" data-roll-type="attack">
						<i class="fa-solid fa-swords"></i> {{localize "USR.Attack"}}
					</button>
					<button class="rollable weapon-roll" data-roll-type="defend">
						<i class="fa-solid fa-shield-halved"></i> {{localize "USR.Defend"}}
					</button>
				</div>
			</div>
			{{/each}} {{#each equippedRanged as |item id|}}
			<div class="weapon-card ranged-card item" data-item-id="{{_id}}">
				<div class="card-header">
					<img
						src="{{item.img}}"
						title="{{item.name}}"
						width="32"
						height="32"
					/>
					<h4 class="weapon-name">{{item.name}}</h4>
					<div class="weapon-controls">
						<a
							class="item-control item-toggle-equipped"
							title="Unequip"
							data-item-id="{{_id}}"
							><i class="fas fa-shield-slash"></i
						></a>
						<a
							class="item-control item-edit"
							title="Edit Item"
							data-item-id="{{_id}}"
							><i class="fas fa-edit"></i
						></a>
					</div>
				</div>
				<div class="card-stats">
					<div class="stat">
						<span class="label">{{localize "USR.Damage"}}:</span>
						<span class="value">{{item.system.damage}}</span>
					</div>
					<div class="stat">
						<span class="label">{{localize "USR.Penetration"}}:</span>
						<span class="value">{{item.system.penetration}}</span>
					</div>
					<div class="stat">
						<span class="label">{{localize "USR.Shots"}}:</span>
						<span class="value"
							>{{item.system.ammo}}/{{item.system.shots}}</span
						>
					</div>
				</div>

				<div class="range-tables">
					<div class="range-group">
						<div class="group-label">{{localize "USR.Normal"}}</div>
						<div class="range-grid">
							{{#each item.rangeTables.normal}}
							<button
								class="range-roll rollable"
								data-roll-usr="{{dice}}"
								data-label="{{../name}} ({{localize label}})"
								data-trait="ranged"
								data-spec="{{../system.specialization}}"
								data-item-id="{{../_id}}"
							>
								<span class="range-label">{{localize label}} ({{dice}}D)</span>
								<span class="range-value">{{value}}</span>
							</button>
							{{/each}}
						</div>
					</div>
					<div class="range-group">
						<div class="group-label">{{localize "USR.Aimed"}}</div>
						<div class="range-grid">
							{{#each item.rangeTables.aimed}}
							<button
								class="range-roll rollable"
								data-roll-usr="{{dice}}"
								data-label="{{../name}} ({{localize label}} - Aimed)"
								data-trait="ranged"
								data-spec="{{../system.specialization}}"
								data-item-id="{{../_id}}"
							>
								<span class="range-label">{{localize label}} ({{dice}}D)</span>
								<span class="range-value">{{value}}</span>
							</button>
							{{/each}}
						</div>
					</div>
				</div>
			</div>
			{{/each}}
		</div>
	</section>

	<h3 class="section-header">Damage Monitor</h3>
	{{#if system.damage.monitor}}
	<div class="damage-monitor">
		{{#each system.damage.monitor}}
		<div class="mod">{{modifier}}</div>
		{{/each}} {{#each system.damage.monitor}}
		<div class="val {{value}}">{{value}}</div>
		{{/each}}
	</div>
	{{/if}}

	<div class="combat-summary grid grid-3col">
		<section class="combat-card">
			<h4 class="subsection-header">Resistance & Armor</h4>
			<table class="damage-resistance-table">
				<tbody>
					{{#each system.damage.resistance as |value type|}}
					<tr>
						<td class="res-label">
							{{localize (concat "USR.DamageResistance" type)}}
						</td>
						<td class="res-value">{{value}}</td>
					</tr>
					{{/each}}
				</tbody>
			</table>

			<div class="active-coverage">
				<span class="coverage-label">Active Coverage:</span>
				<div class="coverage-zones">
					<span class="zone {{#if system.armorCoverage.head}}covered{{/if}}"
						>Head</span
					>
					<span class="zone {{#if system.armorCoverage.torso}}covered{{/if}}"
						>Torso</span
					>
					<span class="zone {{#if system.armorCoverage.arms}}covered{{/if}}"
						>Arms</span
					>
					<span class="zone {{#if system.armorCoverage.legs}}covered{{/if}}"
						>Legs</span
					>
				</div>
			</div>
		</section>

		<section class="combat-card blood-pool">
			<h4 class="subsection-header">{{localize "USR.BloodPool"}}</h4>
			<div class="blood-stats">
				<div class="blood-bar">
					<input
						type="number"
						name="system.blood.value"
						value="{{system.blood.value}}"
						min="0"
						max="{{system.blood.max}}"
					/>
					<span> / {{system.blood.max}}</span>
					<a class="blood-refill" title="Refill Blood Pool"
						><i class="fas fa-sync"></i
					></a>
				</div>
				{{#if system.blood.shock}}
				<div class="shock-warning">
					<i class="fas fa-heart-pulse"></i> {{localize "USR.ShockWarning"}}
				</div>
				{{/if}} {{#if system.blood.dead}}
				<div class="death-warning">
					<i class="fas fa-skull"></i> {{localize "USR.DeathWarning"}}
				</div>
				{{/if}}
			</div>
			<div class="bleeding-status">
				<label>{{localize "USR.Bleeding"}}:</label>
				<select name="system.bleeding">
					{{selectOptions config.bleedingLevels selected=system.bleeding
					localize=true}}
				</select>
			</div>
		</section>

		<section class="combat-card">
			<h4 class="subsection-header">Actions</h4>
			<div class="combat-actions">
				<button class="add-heal">Heal (HP: {{system.health.hp}})</button>
				<button class="remove-stun">Remove Stun</button>
				<button class="add-damage">Take Damage</button>
				{{#if (ne system.bleeding "none")}}
				<button class="apply-bleeding">
					<i class="fa-solid fa-droplet"></i> Apply Bleeding
				</button>
				{{/if}}
			</div>
		</section>
	</div>
</section>
