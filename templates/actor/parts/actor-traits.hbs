<div class="traits-controls">
	<label class="toggle-control">
		{{localize 'USR.ShowEmptySpecializations'}}
		<input
			type="checkbox"
			class="toggle-empty-specs"
			{{checked
			showEmptySpecs}}
		/>
	</label>
</div>
<table class="traits-table">
	<thead>
		<tr>
			<th class="trait-label">{{localize 'USR.Trait'}}</th>
			<th class="trait-value text-center">{{localize 'USR.Level'}}</th>
			<th class="trait-xp text-center">XP</th>
			<th class="trait-roll text-right">{{localize 'USR.Rolls'}}</th>
		</tr>
	</thead>
	<tbody>
		{{#each allTraits as |trait|}} {{>
		"systems/usr/templates/actor/parts/actor-trait.hbs" trait=trait
		key=trait.key }} {{/each}}
	</tbody>
</table>
