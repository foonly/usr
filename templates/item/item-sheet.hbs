{{!-- This template is a fallback for when items don't have more specific
templates. --}} {{!-- Generally, you'll want to make more specific templates
when possible. --}}
<header class="sheet-header">
	<img
		class="profile-img"
		src="{{item.img}}"
		data-action="editImage"
		data-edit="img"
		title="{{item.name}}"
		alt="{{item.name}}"
	/>
	<div class="header-fields">
		<h1 class="charname">
			<input name="name" type="text" value="{{item.name}}" placeholder="Name" />
		</h1>
	</div>
</header>

{{!-- Sheet Tab Navigation --}}
<nav class="sheet-tabs tabs">
	<a
		class="item {{tabs.description.cssClass}}"
		data-action="tab"
		data-group="primary"
		data-tab="description"
		>Description</a
	>
	<a
		class="item {{tabs.attributes.cssClass}}"
		data-action="tab"
		data-group="primary"
		data-tab="attributes"
		>Attributes</a
	>
</nav>

{{!-- Sheet Body --}}
<section class="sheet-body">
	{{!-- Description Tab --}}
	<div
		class="tab {{tabs.description.cssClass}}"
		data-group="primary"
		data-tab="description"
	>
		<prose-mirror
			name="system.description"
			value="{{system.description}}"
			data-document-uuid="{{documentUUID}}"
			toggled
			relative
			{{#unless editable}}disabled{{/unless}}
		>{{{enrichedDescription}}}</prose-mirror>
	</div>

	{{!-- Attributes Tab --}}
	<div
		class="tab attributes {{tabs.attributes.cssClass}}"
		data-group="primary"
		data-tab="attributes"
	>
		{{!-- As you add new fields, add them in here! --}}
	</div>
</section>
