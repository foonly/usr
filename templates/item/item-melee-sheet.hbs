<header class="sheet-header">
	<img
		class="profile-img"
		src="{{item.img}}"
		data-action="editImage"
		data-edit="img"
		title="{{item.name}}"
		alt="{{item.name}}"
	/>
	<div class="header-fields">
		<h1 class="charname">
			<input name="name" type="text" value="{{item.name}}" placeholder="Name" />
		</h1>
	</div>
</header>

{{!-- Sheet Tab Navigation --}}
<nav class="sheet-tabs tabs">
	<a
		class="item {{tabs.description.cssClass}}"
		data-action="tab"
		data-group="primary"
		data-tab="description"
		>Description</a
	>
	<a
		class="item {{tabs.attributes.cssClass}}"
		data-action="tab"
		data-group="primary"
		data-tab="attributes"
		>Attributes</a
	>
</nav>

{{!-- Sheet Body --}}
<section class="sheet-body">
	{{!-- Description Tab --}}
	<div
		class="tab {{tabs.description.cssClass}}"
		data-group="primary"
		data-tab="description"
	>
		<prose-mirror
			name="system.description"
			value="{{system.description}}"
			data-document-uuid="{{documentUUID}}"
			toggled
			relative
			{{#unless editable}}disabled{{/unless}}
		>{{{enrichedDescription}}}</prose-mirror>
	</div>

	{{!-- Attributes Tab --}}
	<div
		class="tab attributes {{tabs.attributes.cssClass}}"
		data-group="primary"
		data-tab="attributes"
	>
		<div class="form-group">
			<label>{{localize "USR.Weight"}}</label>
			<input type="number" name="system.weight" value="{{system.weight}}" />
		</div>
		<div class="form-group">
			<label>{{localize "USR.Damage"}}</label>
			<input type="number" name="system.damage" value="{{system.damage}}" />
		</div>
		<div class="form-group">
			<label>{{localize "USR.Specialization"}}</label>
			<select name="system.specialization">
				{{selectOptions
					specializations
					selected=system.specialization
				}}
			</select>
		</div>
		<div class="form-group">
			<label>{{localize "USR.Lethality"}}</label>
			<select name="system.lethality">
				{{selectOptions
					config.lethalityTypes
					selected=system.lethality
					localize=true
				}}
			</select>
		</div>
		<div class="form-group">
			<label>{{localize "USR.Quickness"}}</label>
			<input type="number" name="system.quickness" value="{{system.quickness}}" />
		</div>
		<div class="form-group">
			<label>{{localize "USR.Impact"}}</label>
			<input type="number" name="system.impact" value="{{system.impact}}" />
		</div>
		<div class="form-group">
			<label>{{localize "USR.DefenseBonus"}}</label>
			<input
				type="number"
				name="system.defenseBonus"
				value="{{system.defenseBonus}}"
			/>
		</div>
		<div class="form-group">
			<label>{{localize "USR.Reach"}}</label>
			<input type="number" name="system.reach" value="{{system.reach}}" />
		</div>
	</div>
</section>
