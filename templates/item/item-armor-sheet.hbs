<header class="sheet-header">
	<img
		class="profile-img"
		src="{{item.img}}"
		data-action="editImage"
		data-edit="img"
		title="{{item.name}}"
		alt="{{item.name}}"
	/>
	<div class="header-fields">
		<h1 class="charname">
			<input name="name" type="text" value="{{item.name}}" placeholder="Name" />
		</h1>
	</div>
</header>

{{!-- Sheet Tab Navigation --}}
<nav class="sheet-tabs tabs">
	<a
		class="item {{tabs.description.cssClass}}"
		data-action="tab"
		data-group="primary"
		data-tab="description"
		>Description</a
	>
	<a
		class="item {{tabs.attributes.cssClass}}"
		data-action="tab"
		data-group="primary"
		data-tab="attributes"
		>Attributes</a
	>
</nav>

{{!-- Sheet Body --}}
<section class="sheet-body">
	{{!-- Description Tab --}}
	<div
		class="tab {{tabs.description.cssClass}}"
		data-group="primary"
		data-tab="description"
	>
		<prose-mirror
			name="system.description"
			value="{{system.description}}"
			data-document-uuid="{{documentUUID}}"
			toggled
			relative
			{{#unless editable}}disabled{{/unless}}
		>{{{enrichedDescription}}}</prose-mirror>
	</div>

	{{!-- Attributes Tab --}}
	<div
		class="tab attributes {{tabs.attributes.cssClass}}"
		data-group="primary"
		data-tab="attributes"
	>
		<div class="form-group">
			<label>{{localize "USR.Weight"}}</label>
			<input type="number" name="system.weight" value="{{system.weight}}" />
		</div>
		<div class="form-group">
			<label>{{localize "USR.Cover"}}</label>
			<input
				type="number"
				name="system.cover"
				value="{{system.cover}}"
				min="1"
				max="6"
			/>
		</div>
		<div class="form-group">
			<label>{{localize "USR.Impact"}}</label>
			<input type="number" name="system.impact" value="{{system.impact}}" min="1" />
		</div>
		<div class="form-group">
			<label>{{localize "USR.DeflectDie"}}</label>
			<select name="system.deflectDie">
				{{selectOptions
					config.deflectDice
					selected=system.deflectDie
					localize=true
				}}
			</select>
		</div>
		<div class="form-group">
			<label>{{localize "USR.DeflectBonus"}}</label>
			<input
				type="number"
				name="system.deflectBonus"
				value="{{system.deflectBonus}}"
				min="0"
			/>
		</div>
		<div class="form-group hit-locations">
			<label>Coverage</label>
			<div class="form-fields">
				<label class="checkbox-label">
					<input
						type="checkbox"
						name="system.locations.head"
						{{checked
						system.locations.head}}
					/>
					Head
				</label>
				<label class="checkbox-label">
					<input
						type="checkbox"
						name="system.locations.torso"
						{{checked
						system.locations.torso}}
					/>
					Torso
				</label>
				<label class="checkbox-label">
					<input
						type="checkbox"
						name="system.locations.arms"
						{{checked
						system.locations.arms}}
					/>
					Arms
				</label>
				<label class="checkbox-label">
					<input
						type="checkbox"
						name="system.locations.legs"
						{{checked
						system.locations.legs}}
					/>
					Legs
				</label>
			</div>
		</div>
	</div>
</section>
