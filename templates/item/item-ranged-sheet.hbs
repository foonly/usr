<header class="sheet-header">
	<img
		class="profile-img"
		src="{{item.img}}"
		data-action="editImage"
		data-edit="img"
		title="{{item.name}}"
		alt="{{item.name}}"
	/>
	<div class="header-fields">
		<h1 class="charname">
			<input name="name" type="text" value="{{item.name}}" placeholder="Name" />
		</h1>
	</div>
</header>

{{!-- Sheet Tab Navigation --}}
<nav class="sheet-tabs tabs">
	<a
		class="item {{tabs.description.cssClass}}"
		data-action="tab"
		data-group="primary"
		data-tab="description"
		>Description</a
	>
	<a
		class="item {{tabs.attributes.cssClass}}"
		data-action="tab"
		data-group="primary"
		data-tab="attributes"
		>Attributes</a
	>
</nav>

{{!-- Sheet Body --}}
<section class="sheet-body">
	{{!-- Description Tab --}}
	<div
		class="tab {{tabs.description.cssClass}}"
		data-group="primary"
		data-tab="description"
	>
		<prose-mirror
			name="system.description"
			value="{{system.description}}"
			data-document-uuid="{{documentUUID}}"
			toggled
			relative
			{{#unless editable}}disabled{{/unless}}
		>{{{enrichedDescription}}}</prose-mirror>
	</div>

	{{!-- Attributes Tab --}}
	<div
		class="tab attributes {{tabs.attributes.cssClass}}"
		data-group="primary"
		data-tab="attributes"
	>
		<div class="form-group">
			<label>{{localize "USR.Weight"}}</label>
			<input type="number" name="system.weight" value="{{system.weight}}" />
		</div>
		<div class="form-group">
			<label>{{localize "USR.Damage"}}</label>
			<input type="number" name="system.damage" value="{{system.damage}}" />
		</div>
		<div class="form-group">
			<label>{{localize "USR.Specialization"}}</label>
			<select name="system.specialization">
				{{selectOptions
					specializations
					selected=system.specialization
				}}
			</select>
		</div>
		<div class="form-group">
			<label>{{localize "USR.Accuracy"}}</label>
			<input
				type="number"
				name="system.accuracy"
				value="{{system.accuracy}}"
				min="1"
				max="7"
			/>
		</div>
		<div class="form-group">
			<label>{{localize "USR.Penetration"}}</label>
			<input
				type="number"
				name="system.penetration"
				value="{{system.penetration}}"
			/>
		</div>
		<div class="form-group">
			<label>{{localize "USR.LethalityModifier"}}</label>
			<input
				type="number"
				name="system.lethalityModifier"
				value="{{system.lethalityModifier}}"
				min="-4"
				max="2"
			/>
		</div>
		<div class="form-group">
			<label>{{localize "USR.Shots"}}</label>
			<input type="number" name="system.shots" value="{{system.shots}}" min="1" />
		</div>
		<div class="form-group">
			<label>{{localize "USR.Reload"}}</label>
			<input type="number" name="system.reload" value="{{system.reload}}" min="1" />
		</div>
		<div class="form-group">
			<label>{{localize "USR.Ammo"}}</label>
			<input type="number" name="system.ammo" value="{{system.ammo}}" min="0" />
		</div>
	</div>
</section>
