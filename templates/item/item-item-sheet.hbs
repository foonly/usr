<header class="sheet-header">
	<img
		class="profile-img"
		src="{{item.img}}"
		data-action="editImage"
		data-edit="img"
		title="{{item.name}}"
		alt="{{item.name}}"
	/>
	<div class="header-fields">
		<h1 class="charname">
			<input name="name" type="text" value="{{item.name}}" placeholder="Name" />
		</h1>
		<div class="grid grid-2col">
			<div class="form-group">
				<label for="item-quantity">Quantity</label>
				<div class="form-fields">
					<input
						id="item-quantity"
						type="number"
						min="0"
						name="system.quantity"
						value="{{system.quantity}}"
						data-dtype="Number"
					/>
				</div>
			</div>
			<div class="form-group">
				<label for="item-weight">Weight</label>
				<div class="form-fields">
					<input
						id="item-weight"
						type="number"
						name="system.weight"
						value="{{system.weight}}"
						data-dtype="Number"
					/>
				</div>
			</div>
		</div>
	</div>
</header>

{{! Sheet Body }}
<section class="sheet-body">
	<prose-mirror
		name="system.description"
		value="{{system.description}}"
		data-document-uuid="{{documentUUID}}"
		toggled
		relative
		{{#unless editable}}disabled{{/unless}}
	>{{{enrichedDescription}}}</prose-mirror>
</section>
