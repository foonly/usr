<div
	class="usr combat-interaction"
	data-attacker-id="{{attacker.id}}"
	data-target-id="{{target.id}}"
>
	{{#if roll}}
	<div class="usr dice-roll attack-roll">
		<div class="dice-result">
			<div class="dice-formula">{{ roll.formula }}</div>
			<div class="dice-tooltip">
				<section class="tooltip-part">
					<div class="dice">
						<header class="part-header flexrow">
							<span class="part-formula"
								>{{ roll.dice.length }}{{ roll.type }}</span
							>
							<span class="part-total">{{roll.successes}}</span>
						</header>
						<ol class="dice-rolls">
							{{#each roll.dice}}
							<li
								class="roll die {{ ../roll.type }}{{#if success }} success{{/if}}"
							>
								{{ value }}
							</li>
							{{/each}}
						</ol>
					</div>
				</section>
			</div>
			<h4 class="dice-total">{{ roll.total }}</h4>
		</div>
	</div>
	{{/if}}

	<div class="interaction-header">
		<div class="attacker">
			<img
				src="{{attacker.img}}"
				title="{{attacker.name}}"
				width="32"
				height="32"
			/>
			<span>{{attacker.name}}</span>
		</div>
		<div class="vs">VS</div>
		<div class="target">
			<img
				src="{{target.img}}"
				title="{{target.name}}"
				width="32"
				height="32"
			/>
			<span>{{target.name}}</span>
		</div>
	</div>

	{{#if defenseRoll}}
	<div class="usr dice-roll defense-roll">
		<div class="dice-result">
			<div class="dice-formula">{{ defenseRoll.formula }}</div>
			<div class="dice-tooltip">
				<section class="tooltip-part">
					<div class="dice">
						<header class="part-header flexrow">
							<span class="part-formula"
								>{{ defenseRoll.dice.length }}{{ defenseRoll.type }}</span
							>
							<span class="part-total">{{defenseRoll.successes}}</span>
						</header>
						<ol class="dice-rolls">
							{{#each defenseRoll.dice}}
							<li
								class="roll die {{ ../defenseRoll.type }}{{#if success }} success{{/if}}"
							>
								{{ value }}
							</li>
							{{/each}}
						</ol>
					</div>
				</section>
			</div>
			<h4 class="dice-total">{{ defenseRoll.total }}</h4>
		</div>
	</div>
	{{/if}}

	<div class="interaction-details">
		<p>
			<strong>{{item.name}}</strong> Attack:
			<span class="success-count attacker-successes">{{attackSuccesses}}</span>
			Successes
		</p>
		{{#if resolved}}
		<p>
			<strong>Defense:</strong>
			<span class="success-count target-successes">{{defenseSuccesses}}</span>
			Successes
		</p>
		{{/if}}
	</div>

	{{#unless resolved}}
	<div class="interaction-controls">
		<div class="defense-trigger">
			<button class="open-defense-dialog">
				<i class="fas fa-shield-alt"></i> Defend
			</button>
		</div>
	</div>
	{{else}}
	<div class="interaction-status resolved-status">
		<p
			class="{{#if (gt netSuccesses 0)}}status-hit{{else}}status-defended{{/if}}"
		>
			{{#if (eq attackSuccesses 0)}}
			<i class="fas fa-times-circle"></i> MISSED! {{else if (gt netSuccesses
			0)}} <i class="fas fa-sword"></i> HIT! {{netSuccesses}} net successes.
			{{else}} <i class="fas fa-shield-check"></i> DEFENDED! {{/if}}
		</p>
	</div>
	{{/unless}}
</div>
