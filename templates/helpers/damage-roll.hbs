<div class="usr dice-roll damage-roll">
	<div class="dice-result">
		<div class="dice-formula">Hit Location (2d10)</div>
		<div class="dice-tooltip">
			<section class="tooltip-part">
				<div class="dice">
					<header class="part-header flexrow">
						<span class="part-formula">2d10</span>
						<span class="part-total">{{total}}</span>
					</header>
					<ol class="dice-rolls">
						{{#each dice}}
						<li class="roll die d10">{{this}}</li>
						{{/each}}
					</ol>
				</div>
			</section>
		</div>
		<div class="damage-details">
			{{#if targetName}}
			<div class="detail-row target-name">
				<span class="label">Target:</span>
				<span class="value" style="font-weight: bold">{{targetName}}</span>
			</div>
			{{/if}}
			<div class="detail-row">
				<span class="label">Location:</span>
				<span class="value">{{location}}</span>
			</div>
			<div class="detail-row">
				<span class="label">Lethality:</span>
				<span class="value lethality-{{lethalityKey}}">{{lethality}}</span>
			</div>
			<div class="detail-row">
				<span class="label">Total Attack Damage:</span>
				<span class="value"
					>{{totalDamage}} ({{baseDamage}} + {{bonusDamage}})</span
				>
			</div>
			{{#if deflectResult}}
			<div class="detail-row armor-deflect">
				<span class="label">Armor Roll ({{deflectResult.coverageKey}}):</span>
				<span class="value"
					>{{deflectResult.rollFormula}} = {{deflectResult.totalDeflect}}</span
				>
			</div>
			{{#if deflectResult.penetration}}
			<div class="detail-row armor-penetration">
				<span class="label">Penetration:</span>
				<span class="value"
					>-{{deflectResult.penetration}} (Net:
					{{deflectResult.netDeflect}})</span
				>
			</div>
			{{else}}
			<div class="detail-row armor-penetration">
				<span class="label">Net Deflect:</span>
				<span class="value">-{{deflectResult.netDeflect}}</span>
			</div>
			{{/if}} {{/if}} {{#if (eq damage 0)}}
			<div class="dice-total damage-total deflected">Deflected</div>
			{{else}}
			<div class="dice-total damage-total">{{damage}} {{lethality}} Damage</div>
			{{/if}}
		</div>
	</div>
</div>
