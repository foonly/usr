<div class="dice-roll damage-roll">
	<div class="dice-result">
		<div class="dice-formula">Hit Location (2d10)</div>
		<div class="dice-tooltip">
			<section class="tooltip-part">
				<div class="dice">
					<header class="part-header flexrow">
						<span class="part-formula">2d10</span>
						<span class="part-total">{{total}}</span>
					</header>
					<ol class="dice-rolls">
						{{#each dice}}
						<li class="roll die d10">{{this}}</li>
						{{/each}}
					</ol>
				</div>
			</section>
		</div>
		<div class="damage-details">
			<div class="detail-row">
				<span class="label">Location:</span>
				<span class="value">{{location}}</span>
			</div>
			<div class="detail-row">
				<span class="label">Lethality:</span>
				<span class="value lethality-{{lethalityKey}}">{{lethality}}</span>
			</div>
			<div class="detail-row">
				<span class="label">Damage:</span>
				<span class="value">{{damage}} ({{baseDamage}} + {{bonusDamage}})</span>
			</div>
		</div>
		<div class="dice-total damage-total">{{damage}} {{lethality}} Damage</div>
	</div>
</div>
