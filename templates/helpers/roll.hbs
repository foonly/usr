<div class="usr dice-roll">
	<div class="dice-result">
		<div class="dice-formula">{{ formula }}</div>
		<div class="dice-tooltip">
			<section class="tooltip-part">
				<div class="dice">
					<header class="part-header flexrow">
						<span class="part-formula">{{ dice.length }}{{ type }}</span>
						<span class="part-total">{{successes}}</span>
					</header>
					<ol class="dice-rolls">
						{{#each dice}}
						<li class="roll die {{ ../type }}{{#if success }} success{{/if}}">
							{{ value }}
						</li>
						{{/each}}
					</ol>
					{{#if hasRerollChips}}
					<div class="reroll-buttons">
						{{#if hasWhiteChip}}
						<button
							class="reroll-btn white-reroll"
							data-chip="white"
							title="Reroll using a White Fate Chip"
						>
							<i class="fas fa-redo"></i> Reroll
						</button>
						{{/if}} {{#if hasGreenChip}}
						<button
							class="reroll-btn green-reroll"
							data-chip="green"
							title="Reroll +1 die using a Green Fate Chip (Max 1 Success)"
						>
							<i class="fas fa-redo"></i> Reroll +1
						</button>
						{{/if}}
					</div>
					{{/if}}
				</div>
			</section>
		</div>
		<h4 class="dice-total">{{ total }}</h4>
	</div>
</div>
