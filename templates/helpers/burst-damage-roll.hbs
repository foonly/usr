<div class="usr dice-roll damage-roll burst-damage-roll">
	<div class="dice-result">
		<div
			class="dice-formula"
			style="
				font-weight: bold;
				font-size: 1.1em;
				border-bottom: 1px solid var(--usr-border);
				padding-bottom: 4px;
				margin-bottom: 8px;
			"
		>
			{{item.name}} — {{fireModeLabel}}<br />
			({{roundsFired}} Rounds) {{#if targetName}}
			<div
				class="target-name"
				style="
					font-size: 0.85em;
					font-weight: normal;
					color: var(--usr-text-muted);
					margin-top: 4px;
				"
			>
				Target:
				<span style="font-weight: bold; color: var(--usr-text-strong)"
					>{{targetName}}</span
				>
			</div>
			{{/if}}
		</div>

		<div class="damage-details">
			{{#unless isMiss}}
			<h4
				class="hits-title"
				style="
					margin: 0 0 6px 0;
					font-weight: bold;
					font-size: 0.9em;
					text-transform: uppercase;
					color: var(--usr-text-muted);
				"
			>
				Hits Summary
			</h4>

			<div
				class="hits-list"
				style="
					margin-bottom: 12px;
					display: flex;
					flex-direction: column;
					gap: 4px;
				"
			>
				{{#each hits}}
				<div
					class="detail-row"
					style="
						display: flex;
						justify-content: space-between;
						padding: 2px 0;
						align-items: center;
					"
				>
					<span
						class="label"
						style="color: var(--usr-text-muted); flex: 1 1 35%"
						>• {{location}}</span
					>
					<span
						class="formula-str"
						style="
							font-size: 0.85em;
							font-weight: normal;
							color: var(--usr-text-muted);
							flex: 1 1 30%;
							text-align: center;
						"
						>{{formulaString}}</span
					>
					<div style="flex: 1 1 35%; text-align: right">
						{{#if (eq damage 0)}}
						<span
							class="value deflected"
							style="color: #c94c4c; font-style: italic; font-weight: bold"
							>Deflected</span
						>
						{{else}}
						<span class="value" style="font-weight: bold"
							>{{damage}} {{lethality}}</span
						>
						{{/if}}
					</div>
				</div>
				{{/each}}
			</div>
			{{/unless}}

			<div
				class="final-merged-damage"
				style="{{#unless isMiss}}border-top: 2px dashed var(--usr-border); padding-top: 10px; margin-top: 8px;{{/unless}}"
			>
				{{#if isMiss}}
				<div
					class="dice-total damage-total missed"
					style="
						text-align: center;
						font-size: 1.5em;
						font-weight: bold;
						color: #c94c4c;
						text-transform: uppercase;
						letter-spacing: 0.05em;
					"
				>
					Missed
				</div>
				{{else if (eq finalDamage 0)}}
				<div
					class="dice-total damage-total deflected"
					style="
						text-align: center;
						font-size: 1.5em;
						font-weight: bold;
						color: #c94c4c;
						text-transform: uppercase;
						letter-spacing: 0.05em;
					"
				>
					Deflected
				</div>
				{{else}}
				<div
					class="dice-total damage-total"
					style="
						text-align: center;
						font-size: 1.5em;
						font-weight: bold;
						color: var(--usr-text-strong);
					"
				>
					{{finalDamage}} {{finalLethality}} Damage
				</div>
				{{/if}}
			</div>
		</div>
	</div>
</div>
